# ==== Telegram Bot ====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABCDEF...

# API credentials от https://my.telegram.org (нужны для входа в аккаунты через Telethon)
API_ID=1234567
API_HASH=your_api_hash_here

# Твой Telegram ID (главный админ). Узнать: напиши боту, он покажет твой ID.
OWNER_ID=123456789

# ==== Хранение ====
DATA_DIR=/app/data
TZ=Europe/Kiev

# ==== Шифрование ====
# Ключ для шифрования паролей 2FA и сессий в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: если потеряешь ключ — не расшифруешь сохранённые сессии и пароли.
ENCRYPTION_KEY=paste_generated_fernet_key_here
